# Copy to .env and fill in. Never commit .env.
# Which client environment to run against. Valid: qa, qap (see utils/env.js).
SIONIQ_CLIENT=qa
# Optional overrides (defaults come from the SIONIQ_CLIENT entry in utils/env.js):
# SIONIQ_URL=https://qa.sioniq.com
# SIONIQ_USER=admin
# SIONIQ_PWD=123
# SIONIQ_BU=Cochin
